# Copy this to .env and fill in real values. .env is gitignored.
PANEL_URL=https://mc-panel.servegame.com
PANEL_TEST_USER=your-test-account-username
PANEL_TEST_PASS=your-test-account-password

# Low-privilege account for the guest permission checks (issue #9).
PANEL_GUEST_USER=guest
PANEL_GUEST_PASS=the-guest-account-password
