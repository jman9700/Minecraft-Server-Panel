# Copy this to .env and fill in real values. .env is gitignored.
PANEL_URL=https://mc-panel.servegame.com
PANEL_TEST_USER=your-test-account-username
PANEL_TEST_PASS=your-test-account-password

# Low-privilege account for the guest permission checks (issue #9).
PANEL_GUEST_USER=guest
PANEL_GUEST_PASS=the-guest-account-password

# Set ONLY if the panel under test overrides PANEL_LOGIN_MAX_ATTEMPTS.
# lockout.spec.ts must use the same value; defaults to 5 when unset.
# PANEL_LOGIN_MAX_ATTEMPTS=5

# How long server-start.setup.ts waits for the Minecraft server to report
# "running" before failing. Defaults to 60. Raise it for a heavy modpack.
# PANEL_SERVER_STARTUP_SECONDS=60

# How long server-stop.teardown.ts waits for the server to shut down.
# Defaults to 60. Raise it if saving the world takes longer.
# PANEL_SERVER_SHUTDOWN_SECONDS=60
